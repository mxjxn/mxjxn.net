                    -@@- -@@@@@@= -@@#%@@@#+#   .@@@@@@- *****@@@@@+  .%@%      .%%.
                    #@#. :@@@@@%. :@@@@@@@-:@.   %@@@+@= *******@@@@%:   -@@+    *********@#.
                   =@@=  .@@@@@#  :@@@@@@+  #-  ***********@@# %=  #@@@@***********    +@@+  .+@%+
                  :%@#   .%@@@@=  -@@@@@#.  =+   #@@-***********+  #@@%***********.     .+@@%*********%@@#.

---
import { createReader } from '@keystatic/core/reader';
import config from '../../keystatic.config';
import { visibleLinks, displayUrl } from '../lib/links.mjs';
import '../styles/site.css';
export const prerender = true;
const reader = createReader(process.cwd(), config);
const directory = await reader.singletons.directory.readOrThrow();
const links = visibleLinks(directory.links);
const description = `${directory.name} — ${directory.description}. ${directory.location}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>mxjxn.net</title>
<meta name="description" content={description}>
<meta property="og:title" content="mxjxn.net">
<meta property="og:description" content={description}>
<meta property="og:url" content="https://mxjxn.net/">
<meta property="og:image" content="https://mxjxn.net/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="mxjxn terminal — Max Jackson, developer, artist, musician, Boston MA">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="mxjxn.net">
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://mxjxn.net/og.png">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230a0d0b'/%3E%3Crect x='6' y='9' width='14' height='5' fill='%239ee06a'/%3E%3Crect x='6' y='18' width='8' height='5' fill='%2366755f'/%3E%3C/svg%3E">


</head>
<body>
<div class="shell">
<header class="topbar">
<a class="host" href="/" aria-label="mxjxn.net home">mxjxn<span>.</span>net</a>
<span class="label">Personal directory / 01</span>
<span class="connection label"><span class="led" aria-hidden="true"></span>{directory.location}</span>
</header>
<main>
<section class="identity" aria-labelledby="name">
<p class="command"><span>~ $</span> whoami</p>
<div class="signature-stage" aria-hidden="true">

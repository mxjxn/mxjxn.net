                    #@#. :@@@@@%. :@@@@@@@-:@.   %@@@+@= *******@@@@%:   -@@+    *********@#.
                   =@@=  .@@@@@#  :@@@@@@+  #-  ***********@@# %=  #@@@@***********    +@@+  .+@%+
                  :%@#   .%@@@@=  -@@@@@#.  =+   #@@-***********+  #@@%***********.     .+@@%*********%@@#.
            ::   .%@#:   .%@@@%.  =@@@@%:   .=  -@@@. =+  =\*\*=.        =%@@@%*******:
            =.  :%@#:    .%@@%=   -%@@#:       .%@@@.      .             :-:.

                      +@%@@@: ***@@%@@@=   -@%@+ .@@@:-@%@: #@@-:@@@@@@:
                      %@+%@@:.%@@***#@@=  .#%%%.  %@@::@%#  #@@-*@@%%@@=
                     :@@-*@@--@@@-*@@+  *@%@+  ***@@--@@-  #@@+@@@***+@@*
                     +@%.+@@=#@@%.+@@+ =@@%@-   =@@=#%@.  *@@%@@@-.%@%        :=
                     %@* =@@*@@@* =@@+-%@@@%+   :@@#@@@:  *@@@@@%. +@@=      ***#

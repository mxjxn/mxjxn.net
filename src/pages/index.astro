╚═╝     ╚═╝╚═╝  ╚═╝ ╚════╝ ╚═╝  ╚═╝╚═╝  ╚═══╝</pre>
</div>
<h1 class="name" id="name">{directory.name}</h1>
<p class="roles">{directory.description}</p>
<p class="location">{directory.location}</p>
<nav class="directory" aria-label="Personal links">
<p class="command"><span>~ $</span> cat links.txt</p>
<div class="links">
{links.map((link, index) => (
<a class="link" href={link.url} target={link.newTab ? '_blank' : undefined} rel={link.newTab ? 'noopener noreferrer' : undefined}>
<span class="number">[{String(index + 1).padStart(2, '0')}]</span>
<span><span class="link-title">{link.label}</span><span class="link-url">{link.description || displayUrl(link.url)}</span></span>
<span class="arrow" aria-hidden="true">↗</span>{link.newTab && <span class="sr-only"> (opens in a new tab)</span>}
</a>
))}
</div>
{links.length > 0 && <p class="hint" id="shortcuts" hidden>Press <kbd>1</kbd>–<kbd>{Math.min(9, links.length)}</kbd> to follow a link.<button class="shortcut-toggle" type="button" aria-pressed="true">Shortcuts on</button></p>}
</nav>
</section>
<aside class="visual" aria-label="Generative geometric artwork">
<div class="visual-bar"><span class="label">Study 001 / rotational symmetry</span><button class="motion" type="button" aria-pressed="false" hidden>Pause motion</button></div>
<div class="field">
<span class="cross cross-a" aria-hidden="true">+</span><span class="cross cross-b" aria-hidden="true">+</span>
<svg class="geometry" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A red geometric rosette inside fine green orbital lines">
<defs><path id="petal" d="M300 116 C440 146 451 320 300 484 C149 320 160 146 300 116Z"/><path id="orbit" d="M300 54 L513 177 L513 423 L300 546 L87 423 L87 177Z"/></defs>
<circle cx="300" cy="300" r="252" stroke="#344b35" stroke-dasharray="1 8"/>
<circle cx="300" cy="300" r="221" stroke="#41563e" stroke-width=".5"/>
<g class="ring ring-outer" stroke="#b0ef8b" stroke-width=".6" opacity=".45"><use href="#orbit"/><use href="#orbit" transform="rotate(20 300 300)"/><use href="#orbit" transform="rotate(40 300 300)"/></g>
<g class="ring ring-inner" stroke="#ff5746" stroke-width="1"><use href="#petal"/><use href="#petal" transform="rotate(30 300 300)"/><use href="#petal" transform="rotate(60 300 300)"/><use href="#petal" transform="rotate(90 300 300)"/><use href="#petal" transform="rotate(120 300 300)"/><use href="#petal" transform="rotate(150 300 300)"/></g>
<g class="ring ring-fine" stroke="#ff5746" stroke-width=".6" opacity=".5"><use href="#petal" transform="rotate(15 300 300)"/><use href="#petal" transform="rotate(45 300 300)"/><use href="#petal" transform="rotate(75 300 300)"/><use href="#petal" transform="rotate(105 300 300)"/><use href="#petal" transform="rotate(135 300 300)"/><use href="#petal" transform="rotate(165 300 300)"/></g>
<path d="M289 300H311M300 289V311" stroke="#e0e5db" stroke-width="1"/><circle cx="300" cy="300" r="5" fill="#e0e5db"/>
</svg>
<span class="field-note" aria-hidden="true">[ x / y ] &nbsp; FORM IN CONTINUOUS ROTATION</span>
</div>
<div class="visual-footer"><span>Geometry / code / play</span><strong aria-hidden="true">✳</strong></div>
</aside>
</main>
<footer><span class="prompt">max@boston:~ $<span class="cursor" aria-hidden="true"></span></span><span id="clock">America / New York</span><span>End of directory <span aria-hidden="true">↵</span></span></footer>
</div>
<script is:inline>
(()=>{
 const motionQuery=matchMedia('(prefers-reduced-motion: reduce)');
 const motionButton=document.querySelector('.motion');
 let paused=motionQuery.matches;
 function updateMotion(){document.body.classList.toggle('paused',paused);motionButton.disabled=motionQuery.matches;motionButton.textContent=motionQuery.matches?'Reduced motion':paused?'Play motion':'Pause motion';motionButton.setAttribute('aria-pressed',String(paused));}
 motionButton.hidden=false;
 motionButton.addEventListener('click',()=>{paused=!paused;updateMotion();});
 motionQuery.addEventListener('change',e=>{paused=e.matches;updateMotion();});
 updateMotion();
 const clock=document.getElementById('clock');
 const formatter=new Intl.DateTimeFormat('en-US',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:'America/New_York',timeZoneName:'short'});
 const tick=()=>{clock.textContent='Boston / '+formatter.format(new Date());};tick();setInterval(tick,15000);
 let shortcuts=true;
 const hint=document.getElementById('shortcuts');if(hint)hint.hidden=false;
 const shortcutButton=document.querySelector('.shortcut-toggle');
 shortcutButton?.addEventListener('click',()=>{shortcuts=!shortcuts;shortcutButton.textContent=shortcuts?'Shortcuts on':'Shortcuts off';shortcutButton.setAttribute('aria-pressed',String(shortcuts));});
 document.addEventListener('keydown',e=>{
  if(!shortcuts||e.defaultPrevented||e.repeat||e.metaKey||e.ctrlKey||e.altKey||e.shiftKey||e.isComposing)return;
  if(e.target instanceof Element&&e.target.closest('input,textarea,select,button,[contenteditable="true"],[role="textbox"]'))return;
  if(!/^[1-9]$/.test(e.key))return;
  const link=document.querySelectorAll('.link')[Number(e.key)-1];if(link){e.preventDefault();link.click();}
 });
})();
</script>
</body>
</html>
